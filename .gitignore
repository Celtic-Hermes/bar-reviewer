# Files Git should never save or upload.

# Mac system files
.DS_Store

# Editor settings
.vscode/

# Anything secret, just in case one is ever created here
.env
.env.*
*.pem
*.key
secrets*

# Private scratch material that stays only on this Mac (raw case text, drafts, thinking).
# Never committed, never uploaded to GitHub, never part of the app.
notes/

# Source documents (official PDFs downloaded for checking wording). Kept on this Mac only.
sources/

# Claude Code helper settings and agents. Kept on this Mac only.
.claude/

# NotebookLM imports (raw answers may quote private notes or reviewers). Kept on this Mac only.
imports/
